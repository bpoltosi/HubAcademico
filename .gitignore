# ==============================================================================
# .gitignore · CTIA (Repositório Acadêmico do CTISM / UFSM)
# Separação clara entre artefatos do Xcode/iOS e ambiente de simulação Web
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Xcode, macOS & Swift Artifacts (Arquivos locais do desenvolvedor iOS)
# ------------------------------------------------------------------------------
# User Data & Schemes locais do Xcode (mantém xcshareddata)
xcuserdata/
*.xcuserdatad
*.xcuserstate
*.pbxuser
!default.pbxuser
*.mode1v3
!default.mode1v3
*.mode2v3
!default.mode2v3
*.perspectivev3
!default.perspectivev3

# Diretórios de compilação do Xcode e SPM
DerivedData/
build/
.build/
.swiftpm/
Packages/
*.hmap
*.ipa
*.dSYM.zip
*.dSYM
*.xctest

# macOS System
.DS_Store
.AppleDouble
.LSOverride
._*
.Spotlight-V100
.Trashes

# ------------------------------------------------------------------------------
# 2. Web Runtime & Dev Server Artifacts (Ambiente do Simulador Web)
# ------------------------------------------------------------------------------
node_modules/
dist/
coverage/
.cache/
.parcel-cache/
.turbo/
*.tsbuildinfo

# Logs do Node/NPM/Bun
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Variáveis de ambiente locais (mantém .env.example)
.env*
!.env.example

# ------------------------------------------------------------------------------
# 3. AI Studio & Temporary Storage
# ------------------------------------------------------------------------------
.tempmediaStorage/
.aistudio/artifacts/brain/*/.tempmediaStorage/
*.tmp
